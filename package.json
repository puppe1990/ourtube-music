{
  "name": "ourtube-music",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Leitor desktop dos endpoints internos do YouTube Music (Innertube WEB_REMIX/ANDROID), em Tauri 2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puppe1990/ourtube-music.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "NODE_ENV=test node --test test/*.test.mjs",
    "dev": "node --max-http-header-size=65536 scripts/dev-proxy.mjs",
    "dist": "node scripts/make-tauri-dist.mjs",
    "tauri:dev": "node scripts/make-tauri-dist.mjs && cargo run --manifest-path src-tauri/Cargo.toml",
    "tauri:build": "node scripts/make-tauri-dist.mjs && cargo build --release --manifest-path src-tauri/Cargo.toml",
    "rust:test": "node scripts/make-tauri-dist.mjs && cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run format:check && npm run lint && npm test",
    "prepare": "husky",
    "icons": "node scripts/make-icons.mjs",
    "bundle": "node scripts/make-tauri-dist.mjs && npx --yes @tauri-apps/cli@2 build --bundles app",
    "install:app": "npm run bundle && rm -rf '/Applications/OurTube Music.app' && cp -R 'src-tauri/target/release/bundle/macos/OurTube Music.app' /Applications/"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.8"
  }
}
