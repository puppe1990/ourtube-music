{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OurTube Music",
  "version": "0.2.0",
  "identifier": "com.gestaobem.ourtube-music",
  "build": {
    "frontendDist": "../.tauri-dist",
    "beforeBuildCommand": "node scripts/make-tauri-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OurTube Music",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
